{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "simple-rs",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/tools/phasar-cli/phasar-cli",
            "args": [
                "-m",
                "target/debug/deps/simple_rs-bfbc34c031ddf687.ll", //this is brittle. it changes with every build
                "-D",
                "ifds-taint",
                "--analysis-config=analysis_config.json",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/examples/simple-rs/",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}