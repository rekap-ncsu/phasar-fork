    "version": "0.2.0",
    "configurations": [

        {
            "name": "simple-str-rs",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/tools/phasar-cli/phasar-cli",
            "args": [
                "-m",
                "target/debug/deps/simple_str_rs-233e9c805b7721fc.ll", //this is brittle. it changes with every build
                "-D",
                "ifds-taint",
                "--analysis-config=analysis-config.json",
                "--entry-points",
                "_ZN13simple_str_rs4main17h0ce9277909836a48E", //also brittle
                "-L",
                "-log-level=DEBUG",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/examples/simple-str-rs/",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
